<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="news_pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <properties>
            <!-- Cấu hình kết nối SQL Server -->
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver" />
            <!-- Thay databaseName=news_db bằng tên CSDL bạn đã tạo trong SSMS -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlserver://localhost:1433;instanceName=SQLEXPRESS;databaseName=week10_exercise4;encrypt=false;trustServerCertificate=true;" />
            <property name="jakarta.persistence.jdbc.user" value="sa" />
            <property name="jakarta.persistence.jdbc.password" value="Dqk120825@" />

            <!-- Tự động tạo/cập nhật bảng -->
            <property
				name="jakarta.persistence.schema-generation.database.action"
				value="drop-and-create" />
            
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>